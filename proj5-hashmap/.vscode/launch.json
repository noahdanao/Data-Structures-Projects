{
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "preLaunchTask": "build hashmap_main",
      "name": "Debug HashMap Main",
      "cwd": "${workspaceFolder}",
      "env": {
        "ASAN_OPTIONS": "abort_on_error=1:detect_leaks=0",
      },
      "program": "${workspaceFolder}/hashmap_main",
    },
    {
      "type": "lldb",
      "request": "launch",
      "preLaunchTask": "build hashmap_tests",
      "name": "Debug HashMap Core",
      "cwd": "${workspaceFolder}",
      "env": {
        "ASAN_OPTIONS": "abort_on_error=1:detect_leaks=0",
      },
      "program": "${workspaceFolder}/hashmap_tests",
      "args": [
        "--gtest_color=yes",
        "--gtest_filter=HashMapCore*",
      ],
    },
    {
      "type": "lldb",
      "request": "launch",
      "preLaunchTask": "build hashmap_tests",
      "name": "Debug HashMap Iter",
      "cwd": "${workspaceFolder}",
      "env": {
        "ASAN_OPTIONS": "abort_on_error=1:detect_leaks=0",
      },
      "program": "${workspaceFolder}/hashmap_tests",
      "args": [
        "--gtest_color=yes",
        "--gtest_filter=HashMapIterating*",
      ],
    },
  ],
}
